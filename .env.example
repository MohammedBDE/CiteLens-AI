# Copy this file to .env and fill in your key:
#   cp .env.example .env
#
# Get a key from https://console.anthropic.com (API Keys -> Create Key).
# Note: an API key requires credits on the API platform. A Claude Pro/Max
# subscription covers claude.ai only and does not include API access.
#
# The .env file is git-ignored and must never be committed.
ANTHROPIC_API_KEY=sk-ant-your-key-here

